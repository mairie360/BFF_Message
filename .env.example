PORT=4003
# Upstreams: <SERVICE>_URL (scheme optional) + optional <SERVICE>_PORT, all required at start-up.
MESSAGE_API_URL=http://localhost:3003
CORE_API_URL=http://localhost:3000
# The APIs, never another BFF (MAIR-525).
PROJECT_API_URL=http://localhost:3001
CALENDAR_API_URL=http://localhost:3002
# Longest life of one GET /stream, in ms (default 300000): the client reconnects then.
# MESSAGE_STREAM_MAX_MS=300000
# Express trust proxy behind the ingress (true, hop count or addresses); unset = no proxy trusted.
# TRUST_PROXY=1
# Per-session limit of GET /business-references (false disables it, e.g. for load tests).
# RATE_LIMIT_ENABLED=false
# BUSINESS_REFERENCES_RATE_LIMIT_MAX=30
# BUSINESS_REFERENCES_RATE_LIMIT_WINDOW_MS=60000
# OpenTelemetry collector (MAIR-504): unset = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
