{
  "name": "bff-message",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "openapi:extract": "ts-node scripts/export-swagger.ts",
    "test": "jest",
    "contracts:generate": "npm run openapi:extract && node scripts/contracts.mjs --generate",
    "contracts:check": "npm run openapi:extract -- --check && node scripts/contracts.mjs --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@mairie360/message-api-openapi": "0.6.1",
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "js-yaml": "^5.0.0"
  },
  "devDependencies": {
    "@mairie360/bff-calendar-openapi": "0.3.0",
    "@mairie360/bff-project-openapi": "0.3.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
